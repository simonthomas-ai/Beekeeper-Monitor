{
  "name": "VespaGuard iPhone HTTPS Test",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "VespaGuard Kamera-Test (HTTPS-Vorschau)",
      "onAutoForward": "openPreview",
      "visibility": "private",
      "protocol": "http"
    }
  },
  "postStartCommand": "python3 -m http.server 8000 --bind 0.0.0.0",
  "customizations": {
    "codespaces": {
      "openFiles": ["index.html"]
    }
  }
}
